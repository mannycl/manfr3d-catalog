---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdminApp from '../../components/AdminApp';
---

<BaseLayout title="Administrar catálogo | Manfr3d.cl">
  <section class="admin-page">
    <div class="admin-top">
      <div>
        <p class="eyebrow">MANFR3D / ADMINISTRACIÓN</p>
        <h1>Catálogo de productos</h1>
        <p>Gestiona lo que tus clientes pueden descubrir.</p>
      </div>
      <a href="/" class="site-link">Ver web ↗</a>
    </div>

    <!-- Renderizamos directamente el componente React aquí -->
    <AdminApp client:only="react" />
  </section>
</BaseLayout>

<style>
  .admin-page {
    padding: 50px clamp(20px, 7vw, 100px) 100px;
    min-height: 70vh;
  }
  .admin-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 30px;
  }
  .eyebrow {
    font-size: .7rem;
    letter-spacing: .15em;
    color: #71836a;
    font-weight: 700;
  }
  .admin-top h1 {
    font-family: Manrope, sans-serif;
    font-size: clamp(2rem, 4vw, 3.5rem);
    letter-spacing: -.06em;
    margin: 0;
  }
  .admin-top p:not(.eyebrow) {
    color: #72796e;
  }
  .site-link {
    background: #263126;
    color: white;
    border-radius: 999px;
    padding: 12px 16px;
    font-size: .85rem;
  }
</style>