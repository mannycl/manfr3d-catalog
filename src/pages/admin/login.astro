---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Acceso administrador | Manfr3d.cl">
  <main class="login-page"><div class="login-card"><p class="eyebrow">MANFR3D / ADMIN</p><h1>Tu catálogo,<br/><em>bajo control.</em></h1><p class="sub">Ingresa con el usuario autorizado para administrar productos y publicaciones.</p><form id="login-form"><label>Correo electrónico<input id="email" type="email" required autocomplete="username" /></label><label>Contraseña<input id="password" type="password" required autocomplete="current-password" /></label><button type="submit">Iniciar sesión ↗</button><p id="error" role="status"></p></form><a class="back" href="/">← Volver a la web</a></div></main>
</BaseLayout>
<script>
  import { getSupabase } from '../../lib/supabase';
  const form = document.querySelector<HTMLFormElement>('#login-form');
  const error = document.querySelector<HTMLElement>('#error');
  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (error) error.textContent = '';
    try {
      const sb = getSupabase();
      const email = (document.querySelector<HTMLInputElement>('#email')?.value || '').trim();
      const password = document.querySelector<HTMLInputElement>('#password')?.value || '';
      const { error: loginError } = await sb.auth.signInWithPassword({ email, password });
      if (loginError) throw loginError;
      window.location.href = '/admin';
    } catch (e) {
      if (error) error.textContent = e instanceof Error ? e.message : 'No se pudo iniciar sesión.';
    }
  });
</script>
<style>
  .login-page{min-height:calc(100vh - 160px);display:grid;place-items:center;padding:40px 20px}.login-card{width:min(100%,460px);background:#fff;border:1px solid #e7e9e0;border-radius:15px;padding:clamp(25px,5vw,48px)}.eyebrow{font-size:.7rem;letter-spacing:.15em;color:#71836a;font-weight:700}.login-card h1{font-family:Manrope,sans-serif;font-size:3rem;letter-spacing:-.07em;line-height:1}.login-card h1 em{font-family:Georgia,serif;color:#71876a;font-weight:500}.sub{color:#73796f;line-height:1.7;font-size:.9rem;margin:20px 0 30px}.login-card form{display:grid;gap:16px}.login-card label{display:grid;gap:7px;font-size:.85rem;font-weight:600}.login-card input{padding:13px;border:1px solid #dfe2d8;border-radius:8px;background:#fbfcf8}.login-card button{background:#263126;color:white;border:0;border-radius:999px;padding:14px;font-weight:700;cursor:pointer}.login-card #error{color:#b42318;font-size:.83rem}.back{display:inline-block;color:#72796e;font-size:.85rem;margin-top:20px}
</style>
