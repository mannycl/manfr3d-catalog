---
const { title = 'Manfr3d.cl | Impresión 3D', description = 'Objetos impresos en 3D, accesorios funcionales y productos personalizados.' } = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f7f2" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/" aria-label="Manfr3d inicio">manfr<span>3</span>d<span class="brand-dot">.</span></a>
      <nav aria-label="Navegación principal">
        <a href="/#catalogo">Catálogo</a>
        <a href="/#como-funciona">Cómo funciona</a>
        <a class="nav-cta" href="/#catalogo">Cotizar producto <span aria-hidden="true">↗</span></a>
      </nav>
    </header>
    <main><slot /></main>
    <footer class="site-footer">
      <a class="brand" href="/">manfr<span>3</span>d<span class="brand-dot">.</span></a>
      <p>Ideas que toman forma. Impresión 3D bajo pedido.</p>
      <small>© {new Date().getFullYear()} Manfr3d.cl</small>
    </footer>
  </body>
</html>
<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap');
  :root{font-family:'DM Sans',sans-serif;color:#20251f;background:#f7f7f2;font-synthesis:none;text-rendering:optimizeLegibility}
  *{box-sizing:border-box}
  body{margin:0}
  a{color:inherit;text-decoration:none}
  button,input,select,textarea{font:inherit}
  .site-header{height:76px;display:flex;align-items:center;justify-content:space-between;padding:0 clamp(20px,6vw,88px);border-bottom:1px solid #e7e8df;background:rgba(247,247,242,.92)}
  .brand{font-family:Manrope,sans-serif;font-weight:800;font-size:1.65rem;letter-spacing:-.08em}
  .brand>span:first-child{color:#64825c}
  .brand-dot{color:#64825c}
  nav{display:flex;align-items:center;gap:30px;font-size:.9rem}
  nav a:not(.nav-cta){color:#53594f}
  .nav-cta{background:#263126;color:white;padding:12px 17px;border-radius:999px}
  main{min-height:60vh}
  .site-footer{display:flex;align-items:center;justify-content:space-between;gap:20px;padding:34px clamp(20px,6vw,88px);border-top:1px solid #e7e8df;color:#656b61;font-size:.85rem}
  .site-footer p{margin:0}
  @media(max-width:650px){.site-header{height:66px}nav{gap:12px;font-size:.82rem}nav a:nth-child(2){display:none}.nav-cta{padding:10px 12px}.site-footer{flex-direction:column;align-items:flex-start;gap:10px}}
</style>
